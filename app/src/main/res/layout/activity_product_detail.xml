<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface_page" android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
    <LinearLayout style="@style/Layout.Page">
        <ImageView android:id="@+id/image" android:layout_width="match_parent" android:layout_height="200dp" android:layout_marginBottom="@dimen/space_m" android:importantForAccessibility="no" android:padding="@dimen/space_xl" tools:background="@color/cat_fruit" tools:src="@drawable/ill_fruit" />
        <TextView android:id="@+id/name" style="@style/Text.Title" android:layout_width="match_parent" android:layout_height="wrap_content" tools:text="Fresa x 500 g" />
        <TextView android:id="@+id/seller" style="@style/Text.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_m" tools:text="Finca El Rosal · Funza · 3,2 km" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_s" android:orientation="horizontal">
            <TextView style="@style/Text.Body" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/price" android:textColor="@color/text_secondary" />
            <TextView android:id="@+id/price" style="@style/Text.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_s" android:orientation="horizontal">
            <TextView style="@style/Text.Body" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/available" android:textColor="@color/text_secondary" />
            <TextView android:id="@+id/available" style="@style/Text.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:id="@+id/description" style="@style/Text.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_m" tools:text="Fresa fresca recogida el mismo día." />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageButton android:id="@+id/decrease" android:layout_width="@dimen/touch_min" android:layout_height="@dimen/touch_min" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/decrease" android:src="@drawable/ic_remove" app:tint="?attr/agroAccentText" />
            <TextView android:id="@+id/quantity" style="@style/Text.Subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:minWidth="32dp" android:text="1" />
            <ImageButton android:id="@+id/increase" android:layout_width="@dimen/touch_min" android:layout_height="@dimen/touch_min" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/increase" android:src="@drawable/ic_add" app:tint="?attr/agroAccentText" />
            <TextView android:id="@+id/unit" style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/space_m" tools:text="Unidad: 500 g" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/addButton" style="@style/Widget.AgroSabana.Button.Accent" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_m" android:text="@string/add_to_cart" app:icon="@drawable/ic_cart" />
    </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>

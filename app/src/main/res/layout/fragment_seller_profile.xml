<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout style="@style/Layout.Page">
        <include android:id="@+id/header" layout="@layout/view_profile_header" />
        <TextView style="@style/Text.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_xs" android:text="@string/dispatch_point" android:textStyle="bold" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="@dimen/map_height" android:layout_marginBottom="@dimen/space_m"
            android:background="@drawable/bg_map_placeholder" android:contentDescription="@string/map_description">
            <ImageView android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center" android:importantForAccessibility="no"
                android:src="@drawable/ic_pin" app:tint="@color/state_error" />
            <!-- Maps SDK en la etapa de backend -->
        </FrameLayout>
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/radiusLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_m" android:hint="@string/delivery_radius" >
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/radius" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/biometricSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/fingerprint_login" />
        <com.google.android.material.button.MaterialButton android:id="@+id/saveButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_s" android:text="@string/save" />
        <com.google.android.material.button.MaterialButton android:id="@+id/editButton" style="@style/Widget.AgroSabana.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_s" android:text="@string/edit_data" />
        <com.google.android.material.button.MaterialButton android:id="@+id/logoutButton" style="@style/Widget.AgroSabana.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_s" android:text="@string/logout" />
        <com.google.android.material.button.MaterialButton android:id="@+id/deleteButton" style="@style/Widget.AgroSabana.Button.TextDanger" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:text="@string/delete_account" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

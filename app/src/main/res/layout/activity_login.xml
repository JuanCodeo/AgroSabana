<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface_page" android:fillViewport="true">
    <LinearLayout style="@style/Layout.Page" android:gravity="center_horizontal">
        <ImageView android:layout_width="72dp" android:layout_height="72dp" android:layout_marginTop="@dimen/space_l" android:contentDescription="@string/logo_description" android:src="@drawable/ic_logo" />
        <TextView style="@style/Text.Display" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_s" android:layout_marginBottom="@dimen/space_xl" android:text="@string/app_name" />
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/emailLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_m" android:hint="@string/email" app:startIconDrawable="@drawable/ic_mail">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/email" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textEmailAddress" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/passwordLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_m" android:hint="@string/password" app:startIconDrawable="@drawable/ic_lock" app:endIconMode="password_toggle">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/password" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/loginButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_s" android:text="@string/login" />
        <com.google.android.material.button.MaterialButton android:id="@+id/forgotButton" style="@style/Widget.AgroSabana.Button.Text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/forgot_password" />
        <LinearLayout android:id="@+id/fingerprintButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_m"
            android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:gravity="center" android:minWidth="@dimen/touch_min" android:orientation="vertical" android:padding="@dimen/space_s" android:visibility="gone" tools:visibility="visible">
            <ImageView android:layout_width="56dp" android:layout_height="56dp" android:importantForAccessibility="no" android:src="@drawable/ic_fingerprint" />
            <TextView style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/login_fingerprint" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/registerButton" style="@style/Widget.AgroSabana.Button.Text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/no_account" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_s" android:background="@drawable/bg_banner_warn" android:orientation="vertical">
            <TextView style="@style/Text.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/demo_title" android:textStyle="bold" />
            <TextView style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/demo_accounts" android:textIsSelectable="true" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="@dimen/space_xs" android:clickable="true" android:focusable="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <ImageView android:id="@+id/image" android:layout_width="match_parent" android:layout_height="@dimen/thumb_grid" android:importantForAccessibility="no" android:padding="@dimen/space_l" tools:background="@color/cat_fruit" tools:src="@drawable/ill_fruit" />
        <TextView android:id="@+id/name" style="@style/Text.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/space_s" android:layout_marginTop="@dimen/space_s" android:ellipsize="end" android:maxLines="1" android:textStyle="bold" tools:text="Fresa x 500 g" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/space_s" android:layout_marginBottom="@dimen/space_s" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/price" style="@style/Text.Price" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="@dimen/text_body" tools:text="$ 8.500" />
            <TextView android:id="@+id/distance" style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:text="3,2 km" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
